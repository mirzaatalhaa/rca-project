# LLM Provider Configuration (Optional - falls back to Mock RCA Mode if not provided)
# Supported providers: mock, openai, gemini
LLM_PROVIDER=mock

# OpenAI Settings (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Settings (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anomaly Detection Settings
STATISTICAL_Z_THRESHOLD=3.0
ISOLATION_FOREST_CONTAMINATION=0.08

# Orchestrator & Remediation Settings
MAX_REMEDIATION_RETRIES=2
REMEDIATION_TIMEOUT_SECONDS=10
AUTO_REMEDIATE=true
